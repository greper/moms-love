<Window x:Class="MomsLove.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="妈妈的爱 · 家长设置" Height="820" Width="1120"
        WindowStartupLocation="CenterOwner" Background="#f6fcfd"
        WindowStyle="None"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <DropShadowEffect x:Key="SoftPanelShadow" Color="#6b9aaa" BlurRadius="20" ShadowDepth="4" Opacity="0.14"/>
        <Style x:Key="RuleImageIcon" TargetType="Image">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RuleFallbackIcon" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#e9f8ff" Offset="0"/>
                <GradientStop Color="#f8fffb" Offset="0.68"/>
                <GradientStop Color="#eef8e9" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Padding="22" Background="#fbfeff" BorderBrush="#cde9f1" BorderThickness="1" CornerRadius="12" Effect="{StaticResource SoftPanelShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="控制列表" FontSize="28" FontWeight="Black" Foreground="#254052"/>
                <Border Grid.Row="1" Margin="0,18,0,16" BorderBrush="#9bd3e6" BorderThickness="1" CornerRadius="12" Background="#effaff">
                    <StackPanel VerticalAlignment="Center" Margin="18">
                        <TextBlock Text="拖入快捷方式、应用程序或目录" TextAlignment="Center"
                                   FontSize="18" FontWeight="Black" Foreground="#254052" TextWrapping="Wrap"/>
                        <TextBlock Text="会自动读取真实应用图标" Margin="0,8,0,0" TextAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#6f8794"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="RuleList" Grid.Row="2" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="12" BorderBrush="#d9edf2" BorderThickness="1" CornerRadius="10" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#eef8fb" BorderBrush="#d3e9f0" BorderThickness="1">
                                        <Grid Margin="5">
                                            <Image Source="{Binding IconPath}" Style="{StaticResource RuleImageIcon}"/>
                                            <TextBlock Text="{Binding IconGlyph}" Style="{StaticResource RuleFallbackIcon}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Black" Foreground="#254052" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding KindLabel}" FontSize="12" Foreground="#6f8794"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Content="启用" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Checked="RuleEnabled_Changed" Unchecked="RuleEnabled_Changed"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2" Padding="24" Background="#fbfeff" BorderBrush="#cde9f1" BorderThickness="1" CornerRadius="12" Effect="{StaticResource SoftPanelShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="控制策略" FontSize="28" FontWeight="Black" Foreground="#254052"/>
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,18,0,4">
                    <Border Margin="0,0,10,14" Padding="18" Background="White" BorderBrush="#d9edf2" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="每天可以玩几次" FontWeight="Black" Foreground="#547281"/>
                            <DockPanel Margin="0,12,0,0" Height="42">
                                <Button Width="42" Content="-" Background="#d9f0f7" Click="DailyMinus_Click"/>
                                <Button DockPanel.Dock="Right" Width="42" Content="+" Background="#d9f0f7" Click="DailyPlus_Click"/>
                                <TextBlock x:Name="DailyCountText" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Black"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Margin="10,0,0,14" Padding="18" Background="White" BorderBrush="#d9edf2" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="每次可以玩多久" FontWeight="Black" Foreground="#547281"/>
                            <DockPanel Margin="0,12,0,0" Height="42">
                                <Button Width="42" Content="-" Background="#d9f0f7" Click="SessionMinus_Click"/>
                                <Button DockPanel.Dock="Right" Width="42" Content="+" Background="#d9f0f7" Click="SessionPlus_Click"/>
                                <TextBlock x:Name="SessionText" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Black"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,10,14" Padding="18" Background="White" BorderBrush="#d9edf2" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="两次之间休息多久" FontWeight="Black" Foreground="#547281"/>
                            <DockPanel Margin="0,12,0,0" Height="42">
                                <Button Width="42" Content="-" Background="#d9f0f7" Click="CooldownMinus_Click"/>
                                <Button DockPanel.Dock="Right" Width="42" Content="+" Background="#d9f0f7" Click="CooldownPlus_Click"/>
                                <TextBlock x:Name="CooldownText" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Black"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Margin="10,0,0,14" Padding="18" Background="White" BorderBrush="#d9edf2" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="收尾宽限时间" FontWeight="Black" Foreground="#547281"/>
                            <DockPanel Margin="0,12,0,0" Height="42">
                                <Button Width="42" Content="-" Background="#d9f0f7" Click="GraceMinus_Click"/>
                                <Button DockPanel.Dock="Right" Width="42" Content="+" Background="#d9f0f7" Click="GracePlus_Click"/>
                                <TextBlock x:Name="GraceText" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Black"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Grid.Row="2" Margin="0,8,0,18" Padding="18" Background="#fff8e2" BorderBrush="#f0df9e" BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <CheckBox x:Name="StartupCheckBox" DockPanel.Dock="Right" Content="开启" FontWeight="Black" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                        <StackPanel>
                            <TextBlock Text="开机自动运行" FontWeight="Black" FontSize="18" Foreground="#254052"/>
                            <TextBlock Text="打开电脑后自动守护规则" Margin="0,4,0,0" Foreground="#6f8794" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="3" Padding="18" Background="#f3fbf0" BorderBrush="#c9e9bd" BorderThickness="1" CornerRadius="10" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="家长密码" FontWeight="Black" FontSize="22" Foreground="#254052"/>
                        <TextBlock Text="密码用于进入设置。当天次数用完后，密码也不能增加游戏时间。" Margin="0,6,0,14"
                                   Foreground="#6f8794" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Width="110" Height="38" Content="修改密码" Background="#76c893" Foreground="White" Click="ChangePassword_Click"/>
                            <Button Width="150" Height="38" Margin="12,0,0,0" Content="清除休息时间" Background="#d9f0f7" Foreground="#315164" Click="ClearRest_Click"/>
                            <Button Width="150" Height="38" Margin="12,0,0,0" Content="重置今日计数" Background="#d9f0f7" Foreground="#315164" Click="ResetTodayCount_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" Margin="0,18,0,0" Padding="16" Background="White" BorderBrush="#d6edf3" BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Width="132" Height="42" Content="保存设置"
                                Background="#ff8f70" Foreground="White" Click="Save_Click"/>
                        <Button DockPanel.Dock="Right" Width="104" Height="42" Margin="0,0,12,0" Content="取消"
                                Background="#eef8fb" Foreground="#315164" Click="Cancel_Click"/>
                        <Button DockPanel.Dock="Left" Width="124" Height="42" Margin="0,0,12,0" Content="退出应用"
                                Background="#f46f56" Foreground="White" Click="ExitApp_Click"/>
                        <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Foreground="#6f8794" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
