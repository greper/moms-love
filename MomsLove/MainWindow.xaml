<Window x:Class="MomsLove.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="妈妈的爱" Height="820" Width="1180"
        Icon="/Assets/app-icon.ico"
        WindowStartupLocation="CenterScreen" Background="#eef9fb" Loaded="Window_Loaded" Closing="Window_Closing"
        WindowStyle="None" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <DropShadowEffect x:Key="SoftCardShadow" Color="#6b9aaa" BlurRadius="22" ShadowDepth="5" Opacity="0.16"/>
        <Style x:Key="ImageIcon" TargetType="Image">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FallbackIcon" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#e9f8ff" Offset="0"/>
                <GradientStop Color="#f8fffb" Offset="0.64"/>
                <GradientStop Color="#e7f7de" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Height="54" Background="#e9f8ff" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="24" Height="24" Source="/Assets/app-icon.ico"/>
                <TextBlock Text="妈妈的爱" Margin="10,0,0,0" FontSize="15" FontWeight="Black" Foreground="#254052" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Grid.Column="1" Text="v0.0" Margin="0,0,12,0" FontSize="12" Foreground="#99b8c4" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="×" FontSize="20" Background="Transparent" Foreground="#486475" Click="CloseButton_Click"/>
        </Grid>

        <DockPanel Grid.Row="1" Margin="36,28,36,0" VerticalAlignment="Top">
            <Button DockPanel.Dock="Right" Width="112" Height="40" Content="家长设置" Background="#76c893" Foreground="White" Click="Settings_Click"/>
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" Background="#ff8f70" CornerRadius="8">
                    <TextBlock Text="♥" Foreground="White" FontSize="21" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="妈妈的爱" Margin="12,0,0,0" FontSize="26" FontWeight="Black" Foreground="#254052" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleSessionText" Text="今天还剩 0 次机会" Margin="20,0,0,0" FontSize="15" FontWeight="Bold" Foreground="#6f8794" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="36,88,36,36">
            <Grid x:Name="IdlePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Margin="0,0,0,20" Padding="34" Background="#f8feff" BorderBrush="#cde9f1" BorderThickness="1" CornerRadius="12" Effect="{StaticResource SoftCardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="今天也可以开心玩一会儿" FontSize="42" FontWeight="Black" Foreground="#254052" TextWrapping="Wrap"/>
                            <TextBlock Text="开始以后这一轮会立刻计时。玩完这一局，我们就去休息一下。"
                                       Margin="0,14,40,0" FontSize="20" FontWeight="SemiBold" Foreground="#607b8a" TextWrapping="Wrap" LineHeight="32"/>
                            <StackPanel Margin="0,30,0,0" Orientation="Horizontal">
                                <Button Width="216" Height="64" Content="▶ 开始玩" Background="#ff8f70" Foreground="White" FontSize="26" Click="StartPlay_Click"/>
                                <Border Margin="18,0,0,0" Padding="18,10" Background="#fff8e2" BorderBrush="#efd982" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="IdleSubText" Text="下一次休息 30 分钟" FontSize="16" FontWeight="Black" Foreground="#765b18"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="310" Height="310" Fill="#dff5fb"/>
                            <Ellipse Width="258" Height="258" Fill="#fffdf4" Stroke="#9ed9eb" StrokeThickness="8"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="这一轮" TextAlignment="Center" FontSize="22" FontWeight="Black" Foreground="#6f8794"/>
                                <TextBlock x:Name="IdleSessionText" Text="30:00" Margin="0,5" TextAlignment="Center" FontSize="68" FontWeight="Black" Foreground="#24465b"/>
                                <TextBlock Text="分钟" TextAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#688292"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Padding="22" Background="#f8feff" BorderBrush="#cde9f1" BorderThickness="1" CornerRadius="12" Effect="{StaticResource SoftCardShadow}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="54" Height="54" CornerRadius="27" Background="#ffd76d">
                            <TextBlock x:Name="IdleCountBadge" Text="2" FontSize="22" FontWeight="Black" Foreground="#805b00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="IdleTitleText" Text="今天还可以玩 2 次" FontSize="22" FontWeight="Black" Foreground="#254052"/>
                            <TextBlock Text="次数用完后今天就不能再从这里打开受控游戏" Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" Foreground="#6f8794"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid x:Name="RunningPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="20" Background="#eaffffff" BorderBrush="#d6edf3" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="220" Height="100" CornerRadius="8" Background="#fffdf4" BorderBrush="#ffb29e" BorderThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Margin="14,8,14,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="本轮剩余时间" FontSize="13" FontWeight="Black" Foreground="#6f8794" TextAlignment="Center"/>
                                    <TextBlock x:Name="RunningTimeText" Text="30:00" FontSize="34" FontWeight="Black" Foreground="#24465b" TextAlignment="Center"/>
                                    <TextBlock x:Name="RunningNoteText" Text="玩完这一局就准备休息" FontSize="11" FontWeight="Bold" Foreground="#688292" TextAlignment="Center"/>
                                </StackPanel>
                                <Canvas Grid.Row="2" Width="180" Height="36" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" ClipToBounds="False">
                                    <Line X1="14" Y1="20" X2="166" Y2="20" Stroke="#6f4a2f" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="16" Y1="16" X2="164" Y2="16" Stroke="#9a7046" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.55"/>
                                    <Line x:Name="BurnedRopeLine" X1="14" Y1="20" X2="14" Y2="20" Stroke="#8d9291" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line x:Name="AshRopeLine" X1="14" Y1="24" X2="14" Y2="24" Stroke="#c4c9c4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Canvas x:Name="RopeFlame" Canvas.Left="6" Canvas.Top="0" Width="28" Height="36">
                                        <Ellipse Canvas.Left="9" Canvas.Top="26" Width="12" Height="6" Fill="#7f8581" Opacity="0.35"/>
                                        <Path Data="M14,32 C1,22 6,13 13,3 C13,11 25,13 20,24 C19,29 17,31 14,32Z" Fill="#ff7043"/>
                                        <Path Data="M15,29 C7,23 10,17 16,10 C17,17 23,19 19,26 C17,28 16,29 15,29Z" Fill="#ffd76d"/>
                                        <Path Data="M14,26 C11,22 13,19 16,16 C17,20 19,22 17,25 C16,26 15,26 14,26Z" Fill="#fff4c7"/>
                                    </Canvas>
                                    <Ellipse x:Name="RopeSparkOne" Canvas.Left="0" Canvas.Top="6" Width="4" Height="4" Fill="#ffd76d"/>
                                    <Ellipse x:Name="RopeSparkTwo" Canvas.Left="0" Canvas.Top="33" Width="3" Height="3" Fill="#ff8f70"/>
                                </Canvas>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="RunningTitleText" Text="选择今天要玩的游戏" FontSize="22" FontWeight="Black" Foreground="#254052"/>
                            <TextBlock x:Name="RunningSubtitleText" Text="这一轮已经开始计时。点击下面的游戏图标就能打开，多个游戏也算同一轮。"
                                       Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#607b8a" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Width="110" Height="40" Content="不玩了" Background="#76c893" Foreground="White" Click="RestNow_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Margin="0,10,0,0" Padding="20" Background="#e6ffffff" BorderBrush="#d6edf3" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock x:Name="GameCountText" DockPanel.Dock="Right" FontSize="15" FontWeight="Black" Foreground="#315164"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="选择游戏" FontSize="22" FontWeight="Black" Foreground="#254052" VerticalAlignment="Center"/>
                                <TextBlock Text=" — 点击下面的游戏图标就能打开，多个游戏也算同一轮" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#607b8a" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GameList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="110" Height="110" Margin="0,0,12,12" Padding="8" Background="#fbfeff" BorderBrush="#dceff4" BorderThickness="1" CornerRadius="10" Cursor="Hand" MouseLeftButtonUp="OpenGame_Click" Tag="{Binding}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="66"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Width="54" Height="54" CornerRadius="12" Background="#eef8fb" BorderBrush="#d3e9f0" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Margin="6">
                                                        <Image Source="{Binding IconPath}" Style="{StaticResource ImageIcon}"/>
                                                        <TextBlock Text="{Binding IconGlyph}" Style="{StaticResource FallbackIcon}" FontSize="22"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Black" Foreground="#254052" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="CooldownPanel" Visibility="Collapsed">
                <Border Padding="34" Background="#f8feff" BorderBrush="#cde9f1" BorderThickness="1" CornerRadius="14" Effect="{StaticResource SoftCardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="92" Height="34" Padding="12,0" HorizontalAlignment="Left" Background="#e3f6dd" CornerRadius="8">
                                <TextBlock Text="休息中" FontSize="15" FontWeight="Black" Foreground="#3e7851" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="现在是休息时间" Margin="0,18,0,0" FontSize="46" FontWeight="Black" Foreground="#254052"/>
                            <TextBlock Text="喝点水，伸伸手，看看远处。休息好了，下一次会更轻松。"
                                       Margin="0,14,48,0" FontSize="21" FontWeight="SemiBold" Foreground="#617d8b" TextWrapping="Wrap" LineHeight="33"/>
                            <Border Margin="0,34,0,0" Width="380" Padding="24" Background="#fffdf4" BorderBrush="#efd982" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="还要休息" FontSize="17" FontWeight="Bold" Foreground="#6f8794"/>
                                        <TextBlock x:Name="CooldownTimeText" Text="30:00" FontSize="62" FontWeight="Black" Foreground="#254052"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="62" Height="62" CornerRadius="31" Background="#ffd76d" VerticalAlignment="Center">
                                        <TextBlock Text="☀" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <UniformGrid Columns="3" Width="520" HorizontalAlignment="Left" Margin="0,20,0,0">
                                <Border Margin="0,0,10,0" Padding="14" Background="#eef8fb" BorderBrush="#d6edf3" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="看看远处" FontSize="16" FontWeight="Black" Foreground="#315164" TextAlignment="Center"/>
                                </Border>
                                <Border Margin="5,0,5,0" Padding="14" Background="#eef8fb" BorderBrush="#d6edf3" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="喝一口水" FontSize="16" FontWeight="Black" Foreground="#315164" TextAlignment="Center"/>
                                </Border>
                                <Border Margin="10,0,0,0" Padding="14" Background="#eef8fb" BorderBrush="#d6edf3" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="活动手腕" FontSize="16" FontWeight="Black" Foreground="#315164" TextAlignment="Center"/>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                        <Border Grid.Column="1" Margin="22,20,0,20" Padding="10" Background="White" BorderBrush="#d9e9ed" BorderThickness="1" CornerRadius="14">
                            <Border CornerRadius="10" ClipToBounds="True" Background="#effaff">
                                <Image Source="/Assets/rest-illustration.png" Stretch="UniformToFill"/>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="LockedPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="今天的游戏时间已经用完啦" FontSize="46" FontWeight="Black" Foreground="#254052" TextWrapping="Wrap"/>
                    <TextBlock Text="明天还会有新的游戏时间。现在可以换个小计划，让今天也很棒。"
                               Margin="0,18,0,0" FontSize="22" FontWeight="SemiBold" Foreground="#617d8b" TextWrapping="Wrap" Width="620" HorizontalAlignment="Left"/>
                    <StackPanel Margin="0,32,0,0" Width="420" HorizontalAlignment="Left">
                        <Border Margin="0,0,0,10" Padding="16" Background="White" BorderBrush="#d6edf3" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="喝一杯水" FontSize="19" FontWeight="Black" Foreground="#254052"/>
                        </Border>
                        <Border Margin="0,0,0,10" Padding="16" Background="White" BorderBrush="#d6edf3" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="看一页喜欢的书" FontSize="19" FontWeight="Black" Foreground="#254052"/>
                        </Border>
                        <Border Padding="16" Background="White" BorderBrush="#d6edf3" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="画一个今天的好点子" FontSize="19" FontWeight="Black" Foreground="#254052"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Margin="24,80,0,80" Background="#effaff" BorderBrush="#d6edf3" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Image Source="/Assets/game-finished-illustration.png" Stretch="UniformToFill"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>


