<Window x:Class="MomsLove.ConfirmPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建家长密码" Height="390" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <DropShadowEffect x:Key="DialogShadow" Color="#486475" BlurRadius="28" ShadowDepth="8" Opacity="0.24"/>
    </Window.Resources>
    <Border Margin="24" Padding="26" Background="#fbfeff" BorderBrush="#8fcfe4" BorderThickness="2" CornerRadius="12" Effect="{StaticResource DialogShadow}" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="创建家长密码" FontSize="26" FontWeight="Black" Foreground="#254052"/>
            <TextBlock x:Name="HintText" Grid.Row="1" Margin="0,10,0,18"
                       Text="第一次进入设置，请输入两次相同的家长密码。"
                       TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Foreground="#6f8794"/>
            <StackPanel Grid.Row="2">
                <TextBlock Text="输入密码" FontWeight="Black" Foreground="#547281"/>
                <PasswordBox x:Name="PasswordBox" Height="44" Margin="0,8,0,14" FontSize="20" Padding="8,4"/>
            </StackPanel>
            <StackPanel Grid.Row="3">
                <TextBlock Text="再次输入" FontWeight="Black" Foreground="#547281"/>
                <PasswordBox x:Name="ConfirmBox" Height="44" Margin="0,8,0,0" FontSize="20" Padding="8,4"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Grid.Row="4" Margin="0,10,0,0" Foreground="#f46f56" FontWeight="Black"/>
            <StackPanel Grid.Row="5" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" Width="104" Margin="0,0,12,0" Content="取消"
                        Background="#eef8fb" Foreground="#315164" BorderBrush="#c9e8ef" Click="Cancel_Click"/>
                <Button Style="{StaticResource DialogButton}" Width="124" Content="确认"
                        Background="#ff8f70" Foreground="White" BorderBrush="#ff8f70" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
