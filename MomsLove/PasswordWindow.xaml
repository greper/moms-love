<Window x:Class="MomsLove.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="家长密码" Height="320" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <DropShadowEffect x:Key="DialogShadow" Color="#486475" BlurRadius="28" ShadowDepth="8" Opacity="0.24"/>
    </Window.Resources>
    <Border Margin="24" Padding="26" Background="#fbfeff" BorderBrush="#8fcfe4" BorderThickness="2" CornerRadius="12" Effect="{StaticResource DialogShadow}" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Black" Foreground="#254052"/>
            <TextBlock x:Name="HintText" Grid.Row="1" Margin="0,10,0,18" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Foreground="#6f8794"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="2" Height="44" FontSize="20" Padding="8,4"/>
            <StackPanel Grid.Row="4" Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" Width="104" Margin="0,0,12,0" Content="取消"
                        Background="#eef8fb" Foreground="#315164" BorderBrush="#c9e8ef" Click="Cancel_Click"/>
                <Button Style="{StaticResource DialogButton}" Width="124" Content="确认"
                        Background="#ff8f70" Foreground="White" BorderBrush="#ff8f70" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
